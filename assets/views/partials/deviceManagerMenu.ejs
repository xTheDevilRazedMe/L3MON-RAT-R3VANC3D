<!-- Device Manager Sidebar -->
<div class="w-48 flex-shrink-0">
    <div class="space-y-1">
        <a href="<%= baseURL %>/info" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium transition-all
            <% if (page==='info') { %> bg-accent-blue/10 text-accent-blue <% } else { %> text-slate-400 hover:text-white hover:bg-bg-hover <% } %>">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Info
        </a>
        <a href="<%= baseURL %>/gps" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium transition-all
