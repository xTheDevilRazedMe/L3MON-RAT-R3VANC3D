        </a>
        <a href="<%= baseURL %>/settings" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium transition-all
            <% if (page==='settings') { %> bg-accent-blue/10 text-accent-blue <% } else { %> text-slate-400 hover:text-white hover:bg-bg-hover <% } %>">
