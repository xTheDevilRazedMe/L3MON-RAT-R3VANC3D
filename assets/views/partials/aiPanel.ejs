<style>
    #ai-panel {
        position:fixed; top:56px; right:0; bottom:0; width:360px; z-index:45;
        display:flex; flex-direction:column; font-size:13px;
        background:#151d2b; border-left:1px solid rgba(59,130,246,0.15);
        transform:translateX(0); transition:transform 0.35s cubic-bezier(0.4,0,0.2,1), opacity 0.3s;
    }
    #ai-panel.collapsed { transform:translateX(360px); opacity:0; pointer-events:none; }
    #ai-toggle {
        position:fixed; right:360px; top:50%; z-index:46;
        background:#3b82f6; color:#fff; border:none; cursor:pointer;
        padding:12px 5px; border-radius:6px 0 0 6px; font-size:13px;
        transform:translateY(-50%); transition:right 0.35s cubic-bezier(0.4,0,0.2,1), background 0.2s;
    }
    #ai-toggle:hover { background:#2563eb; }
    body.ai-open #ai-toggle { right:360px; }
    body.ai-closed #ai-toggle { right:0; }
    .ai-msg { margin-bottom:6px; padding:7px 10px; border-radius:8px; max-width:92%; word-wrap:break-word; line-height:1.4; animation:fadeIn 0.2s ease; }
    @keyframes fadeIn { from { opacity:0; transform:translateY(4px); } to { opacity:1; transform:translateY(0); } }
    .ai-msg.user { background:#3b82f6; color:#fff; margin-left:auto; border-bottom-right-radius:2px; }
    .ai-msg.assistant { background:#1e293b; color:#e2e8f0; border-left:3px solid #8b5cf6; border-bottom-left-radius:2px; }
    .ai-msg.tool { background:#0f172a; color:#94a3b8; font-size:11px; border-left:3px solid #f59e0b; padding:5px 8px; }
    .ai-msg.system { background:transparent; color:#64748b; font-style:italic; text-align:center; font-size:11px; }
    .ai-msg code { background:rgba(255,255,255,0.1); padding:1px 4px; border-radius:3px; font-size:12px; }
    .ai-msg pre { background:#0f172a; padding:8px; border-radius:4px; margin:4px 0; overflow-x:auto; font-size:11px; }
    .ai-msg pre code { background:none; padding:0; }
    .ai-msg .copy-btn { opacity:0; transition:opacity 0.2s; }
    .ai-msg:hover .copy-btn { opacity:1; }
</style>

<!-- AI Panel -->
<div id="ai-panel">
    <!-- Header -->
    <div style="padding:10px 14px; border-bottom:1px solid rgba(59,130,246,0.15); display:flex; justify-content:space-between; align-items:center; flex-shrink:0;">
        <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-lg flex items-center justify-center" style="background:linear-gradient(135deg,#3b82f6,#8b5cf6);">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
            </div>
            <div>
                <span class="text-white font-semibold text-sm">L3MON AI</span>
                <span class="text-slate-500 text-xs ml-1" id="ai-model-display">Agent</span>
            </div>
        </div>
        <div class="flex items-center gap-1">
            <button onclick="toggleAISettings()" class="w-7 h-7 rounded flex items-center justify-center hover:bg-white/5 transition-colors" title="Settings">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.293.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </button>
            <button onclick="toggleAIPanel()" class="w-7 h-7 rounded flex items-center justify-center hover:bg-white/5 transition-colors">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
    </div>

    <!-- Messages -->
    <div id="ai-messages" style="flex:1; overflow-y:auto; padding:10px;">
        <div class="ai-msg system">L3MON AI Agent — connected to your device. Type commands or ask questions.</div>
        <div class="ai-msg system">Type <code>/help</code> to see available commands.</div>
    </div>

    <!-- Input -->
    <div style="padding:8px 10px; border-top:1px solid rgba(59,130,246,0.15); flex-shrink:0;">
        <div style="display:flex; gap:6px; align-items:center;">
            <input type="text" id="ai-input" placeholder="Ask anything or use /help..." 
                   style="flex:1; background:#0f172a; border:1px solid #1e293b; color:#e2e8f0; padding:8px 10px; border-radius:6px; font-size:13px; outline:none;"
                   onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#1e293b'"
                   onkeydown="if(event.key==='Enter')sendAIMsg()">
            <button id="ai-send-btn" onclick="sendAIMsg()" style="background:#3b82f6; color:#fff; border:none; padding:8px 12px; border-radius:6px; cursor:pointer; font-size:12px; white-space:nowrap; transition:background 0.2s;">Send</button>
        </div>
        <div style="font-size:10px; color:#475569; margin-top:4px; text-align:center;">Agent mode • Tool-calling enabled</div>
    </div>
</div>

<!-- Toggle Button (always visible) -->
<button id="ai-toggle" onclick="toggleAIPanel()" title="AI Agent">&#9664;</button>

<!-- Settings Modal -->
<div id="ai-settings-overlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:100; justify-content:center; align-items:center;">
    <div style="background:#151d2b; padding:20px; border-radius:12px; width:380px; border:1px solid rgba(59,130,246,0.2); box-shadow:0 8px 32px rgba(0,0,0,0.4);">
        <h4 style="color:#e2e8f0; margin:0 0 12px;">AI Provider Settings</h4>
        <label style="color:#94a3b8; font-size:12px; display:block; margin-bottom:4px;">Endpoint URL</label>
        <input id="ai-endpoint" type="text" placeholder="https://api.openai.com" style="width:100%; background:#0f172a; border:1px solid #1e293b; color:#e2e8f0; padding:8px; border-radius:4px; margin-bottom:8px;">
        <label style="color:#94a3b8; font-size:12px; display:block; margin-bottom:4px;">API Key</label>
        <input id="ai-apikey" type="password" placeholder="sk-..." style="width:100%; background:#0f172a; border:1px solid #1e293b; color:#e2e8f0; padding:8px; border-radius:4px; margin-bottom:8px;">
        <label style="color:#94a3b8; font-size:12px; display:block; margin-bottom:4px;">Model</label>
        <div style="display:flex; gap:6px;">
            <input id="ai-model" type="text" placeholder="gpt-4o" style="flex:1; background:#0f172a; border:1px solid #1e293b; color:#e2e8f0; padding:8px; border-radius:4px;">
            <button onclick="fetchModels()" style="background:#1e293b; color:#94a3b8; border:1px solid #334155; padding:8px 12px; border-radius:4px; cursor:pointer;">Detect</button>
        </div>
        <div id="ai-models-list" style="max-height:120px; overflow-y:auto; margin-top:6px;"></div>
        <div style="display:flex; gap:6px; margin-top:12px;">
            <button onclick="saveAISettings()" style="background:#3b82f6; color:#fff; border:none; padding:8px 16px; border-radius:4px; cursor:pointer; flex:1;">Save</button>
            <button onclick="toggleAISettings()" style="background:#1e293b; color:#94a3b8; border:1px solid #334155; padding:8px 16px; border-radius:4px; cursor:pointer;">Cancel</button>
        </div>
        <div id="ai-settings-msg" style="color:#22c55e; font-size:11px; margin-top:6px;"></div>
    </div>
</div>

<script>
    var aiPanelOpen = false;
    function toggleAIPanel() {
        aiPanelOpen = !aiPanelOpen;
        document.getElementById('ai-panel').classList.toggle('collapsed', !aiPanelOpen);
        document.body.classList.toggle('ai-open', aiPanelOpen);
        document.body.classList.toggle('ai-closed', !aiPanelOpen);
        document.getElementById('ai-toggle').innerHTML = aiPanelOpen ? '&#9664;' : '&#9654;';
    }
    // Auto-hide on load
    document.body.classList.add('ai-closed');
    document.getElementById('ai-panel').classList.add('collapsed');
    document.getElementById('ai-toggle').innerHTML = '&#9654;';
    document.getElementById('ai-toggle').style.display = '';

    function toggleAISettings() {
        document.getElementById('ai-settings-overlay').classList.toggle('show');
    }

    function showAIMsg(role, text) {
        var d = document.getElementById('ai-messages');
        var el = document.createElement('div');
        el.className = 'ai-msg ' + role;
        el.textContent = text;
        d.appendChild(el);
        d.scrollTop = d.scrollHeight;
    }

    function sendAIMsg() {
        var inp = document.getElementById('ai-input');
        var text = inp.value.trim();
        if (!text) return;
        showAIMsg('user', text);
        inp.value = '';
        var msgs = [];
        document.querySelectorAll('#ai-messages .ai-msg').forEach(function(m) {
            var r = m.classList.contains('user') ? 'user' : (m.classList.contains('assistant') ? 'assistant' : null);
            if (r) msgs.push({ role: r, content: m.textContent });
        });
        if (text.startsWith('/')) {
            $.post('/ai/cmd', { cmd: text }, function(d) { showAIMsg('assistant', d.reply || d.error || 'No response'); });
        } else {
            var thinkEl = document.createElement('div');
            thinkEl.className = 'ai-msg assistant';
            thinkEl.innerHTML = '<em style="color:#8b5cf6;">Agent is working...</em>';
            document.getElementById('ai-messages').appendChild(thinkEl);
            document.getElementById('ai-messages').scrollTop = document.getElementById('ai-messages').scrollHeight;
            $.post('/ai/chat', { messages: msgs }, function(d) {
                thinkEl.remove();
                if (d.trace && d.trace.length > 0) {
                    d.trace.forEach(function(t) {
                        var tEl = document.createElement('div');
                        tEl.className = 'ai-msg tool';
                        var label = t.name + ': ' + JSON.stringify(t.args || {});
                        tEl.innerHTML = '&#9881; ' + label.slice(0, 80);
                        document.getElementById('ai-messages').appendChild(tEl);
                    });
                }
                showAIMsg('assistant', d.reply || d.error || 'No response');
            });
        }
    }

    function saveAISettings() {
        $.post('/ai/config', {
            endpoint: $('#ai-endpoint').val(), apiKey: $('#ai-apikey').val(), model: $('#ai-model').val()
        }, function(d) { $('#ai-settings-msg').text(d.error || 'Saved!'); loadAIConfig(); });
    }

    function loadAIConfig() {
        $.get('/ai/config', function(d) {
            $('#ai-endpoint').val(d.endpoint || '');
            $('#ai-apikey').val(d.apiKey || '');
            $('#ai-model').val(d.model || '');
            if (d.model) $('#ai-model-display').textContent = d.model;
        });
    }

    function fetchModels() {
        $.post('/ai/models', function(d) {
            if (d.error) { $('#ai-settings-msg').text(d.error); return; }
            var list = $('#ai-models-list');
            list.empty();
            (d.models || []).forEach(function(m) {
                list.append('<div onclick="$(\'#ai-model\').val(\'' + m + '\')" style="padding:4px 8px; cursor:pointer; color:#94a3b8; font-size:11px; border-radius:4px; transition:background 0.15s;" onmouseover="this.style.background=\'#1e293b\'" onmouseout="this.style.background=\'transparent\'">' + m + '</div>');
            });
            if (d.models && d.models.length > 0 && !$('#ai-model').val()) $('#ai-model').val(d.models[0]);
        });
    }

    $(function() { loadAIConfig(); });
</script>
