<!-- Tabs -->
<div class="flex border-b border-slate-700/50 mb-4">
    <button class="px-4 py-2 text-sm font-medium text-accent-blue border-b-2 border-accent-blue" onclick="showTab('sms-log')" id="tab-sms-log">SMS Log</button>
    <button class="px-4 py-2 text-sm font-medium text-slate-400 border-b-2 border-transparent hover:text-white transition-colors" onclick="showTab('sms-send')" id="tab-sms-send">Send SMS</button>
</div>

<!-- SMS Log Tab -->
<div id="tab-sms-log">
    <div class="flex justify-end mb-4">
        <button onclick="updateButton(this, '0xSM', {'action': 'ls'})" class="btn-primary text-xs">
            <svg class="w-3 h-3 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            Refresh
        </button>
    </div>

    <div class="space-y-3 max-h-[500px] overflow-y-auto pr-2">
        <% pageData.forEach((smsData) => { 
            let date = new Date(parseInt(smsData.date));
            let isIncoming = smsData.type === "1";
            let isOutgoing = smsData.type === "2";
        %>
        <div class="glass-bright rounded-lg p-4 flex items-start gap-3">
            <div class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0
                <%= isIncoming ? 'bg-accent-green/20 text-accent-green' : isOutgoing ? 'bg-accent-blue/20 text-accent-blue' : 'bg-slate-700 text-slate-400' %>">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <% if (isIncoming) { %>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                    <% } else if (isOutgoing) { %>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
                    <% } else { %>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    <% } %>
                </svg>
            </div>
            <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                    <a href="?filter=<%= smsData.address %>" class="text-white font-medium text-sm hover:text-accent-blue transition-colors"><%= smsData.address %></a>
                    <span class="text-slate-500 text-xs"><%= date.toLocaleString('en-GB', { timeZone: 'UTC' }) %></span>
                </div>
                <p class="text-slate-300 text-sm mt-1 break-words"><%= smsData.body %></p>
            </div>
        </div>
        <% }); %>
        <% if (pageData.length === 0) { %>
        <div class="text-center py-12 text-slate-500">
            <svg class="w-12 h-12 mx-auto mb-3 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
            <p>No SMS messages found.</p>
        </div>
        <% } %>
    </div>
</div>

<!-- Send SMS Tab -->
<div id="tab-sms-send" style="display:none;">
    <div class="max-w-lg">
        <div class="space-y-4">
            <div>
                <label class="block text-slate-400 text-sm mb-1">To Number</label>
                <input id="to" type="number" placeholder="Phone number" class="w-full px-3 py-2">
            </div>
            <div>
                <label class="block text-slate-400 text-sm mb-1">Message</label>
                <textarea id="sms" rows="4" placeholder="Type your message..." class="w-full px-3 py-2 resize-none"></textarea>
            </div>
            <button onclick="sendSMS(this)" class="btn-success w-full py-2.5 text-sm font-medium">
                <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
                Send SMS
            </button>
        </div>
    </div>
</div>

<script>
    function showTab(tab) {
        document.getElementById('tab-sms-log').style.display = tab === 'sms-log' ? '' : 'none';
        document.getElementById('tab-sms-send').style.display = tab === 'sms-send' ? '' : 'none';
        document.getElementById('tab-sms-log').previousElementSibling.querySelectorAll('button').forEach(b => {
            b.classList.toggle('text-accent-blue', b.id === 'tab-' + tab);
            b.classList.toggle('border-accent-blue', b.id === 'tab-' + tab);
            b.classList.toggle('text-slate-400', b.id !== 'tab-' + tab);
            b.classList.toggle('border-transparent', b.id !== 'tab-' + tab);
        });
    }
    function sendSMS(el) {
        el.disabled = true;
        el.textContent = 'Sending...';
        sendCommand('0xSM', { action: 'sendSMS', sms: $('#sms').val(), to: $('#to').val() }, function(error, message) {
            el.disabled = false;
            el.innerHTML = '<svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg> Send SMS';
            if (error) showNotification('#f03434', error);
            else showNotification('#2ecc71', message === 'Requested' ? 'SMS Sent' : message);
        });
    }
</script>
