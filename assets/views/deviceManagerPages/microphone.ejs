<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Live Mic -->
    <div>
        <h3 class="text-white font-semibold text-lg mb-2">Live Microphone</h3>
        <p class="text-slate-400 text-sm mb-4">Stream live audio from the device. Audio plays in real-time as it's captured.</p>

        <div class="glass-bright rounded-xl p-6">
            <div class="flex items-center gap-3 mb-4">
                <label class="text-slate-400 text-sm whitespace-nowrap">Chunk duration:</label>
                <select id="micDuration" class="w-24 px-3 py-2 text-sm">
                    <option value="1">1s</option>
                    <option value="2" selected>2s</option>
                    <option value="3">3s</option>
                    <option value="5">5s</option>
                </select>
            </div>

            <!-- Volume Visualizer -->
            <div class="bg-slate-800/50 rounded-lg h-20 mb-4 flex items-center justify-center overflow-hidden" id="micVisualizer">
                <div class="text-slate-600 text-sm">No audio</div>
            </div>

            <button onclick="toggleLiveMic()" id="liveMicBtn" class="w-full py-2.5 text-sm font-medium transition-all flex items-center justify-center gap-2 rounded-lg">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
                Start Live Mic
            </button>
            <p class="text-slate-500 text-xs mt-2 text-center" id="micStatus">Ready</p>
        </div>
    </div>

    <!-- Single Recording -->
    <div>
        <h3 class="text-white font-semibold text-lg mb-2">Single Recording</h3>
        <p class="text-slate-400 text-sm mb-4">Record a fixed-duration audio clip and download it.</p>

        <div class="glass-bright rounded-xl p-6">
            <div class="flex items-center gap-3 mb-4">
                <label class="text-slate-400 text-sm whitespace-nowrap">Duration (sec):</label>
                <input type="number" id="micRecDuration" value="10" min="1" max="120" class="w-24 px-3 py-2 text-sm">
            </div>
            <button onclick="startSingleRecord()" id="singleRecBtn" class="w-full btn-danger py-2.5 text-sm font-medium flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                Record Once
            </button>
        </div>

        <!-- Recordings List -->
        <div class="mt-6">
            <h4 class="text-white font-semibold text-sm mb-3">Recordings</h4>
            <div class="space-y-2" id="recList">
                <% if (pageData && pageData.length > 0) { pageData.forEach((rec) => { %>
                <div class="glass-bright rounded-lg p-3 flex items-center justify-between">
                    <div class="flex items-center gap-3 min-w-0">
                        <svg class="w-4 h-4 text-accent-purple flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
                        <span class="text-white text-sm truncate"><%= rec.originalName %></span>
                    </div>
                    <div class="flex items-center gap-2">
                        <audio controls src="/manage/<%= deviceID %>/downloads/<%= rec.path.split('/').pop() %>" class="h-8"></audio>
                    </div>
                </div>
                <% }); } else { %>
                <p class="text-slate-500 text-center py-6 text-sm">No recordings yet.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script>
    var liveMicActive = false;
    var micPollInterval = null;

    function toggleLiveMic() {
        var btn = document.getElementById('liveMicBtn');
        var status = document.getElementById('micStatus');
        if (liveMicActive) {
            $.post('/manage/<%= deviceID %>/mic/live/stop', function() {
                liveMicActive = false;
                btn.className = 'w-full py-2.5 text-sm font-medium transition-all flex items-center justify-center gap-2 rounded-lg btn-danger';
                btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg> Start Live Mic';
                status.textContent = 'Stopped';
                clearInterval(micPollInterval);
                document.getElementById('micVisualizer').innerHTML = '<div class="text-slate-600 text-sm">No audio</div>';
            });
        } else {
            var dur = document.getElementById('micDuration').value;
            $.post('/manage/<%= deviceID %>/mic/live/start', { duration: dur }, function(d) {
                if (d.error) { showNotification('#f03434', d.error); return; }
                liveMicActive = true;
                btn.className = 'w-full py-2.5 text-sm font-medium transition-all flex items-center justify-center gap-2 rounded-lg btn-success';
                btn.innerHTML = '<div class="w-3 h-3 bg-white rounded-full animate-pulse"></div> Stop Live Mic';
                status.textContent = 'Streaming...';
                // Poll for audio files
                var lastIdx = 0;
                micPollInterval = setInterval(function() {
                    $.get('/manage/<%= deviceID %>/mic/live/last/' + lastIdx, function(d) {
                        if (d.files && d.files.length > 0) {
                            d.files.forEach(function(f, i) {
                                lastIdx = Math.max(lastIdx, f.idx || (lastIdx + 1));
                                var audio = new Audio(f.url);
                                audio.play().catch(function() {});
                                // Visualizer
                                var viz = document.getElementById('micVisualizer');
                                viz.innerHTML = '<div class="flex items-end gap-0.5 h-16">' +
                                    Array.from({length: 20}, () => '<div class="w-2 bg-accent-green rounded-t transition-all" style="height:' + (10 + Math.random()*50) + '%"></div>').join('') + '</div>';
                                setTimeout(function() { viz.innerHTML = '<div class="text-slate-600 text-sm">No audio</div>'; }, dur * 800);
                            });
                        }
                    });
                }, (parseInt(dur) + 0.5) * 1000);
            });
        }
    }

    function startSingleRecord() {
        var dur = document.getElementById('micRecDuration').value;
        var btn = document.getElementById('singleRecBtn');
        btn.disabled = true;
        btn.textContent = 'Recording...';
        sendCommand('0xMI', { sec: parseInt(dur) }, function(error, message) {
            btn.disabled = false;
            btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg> Record Once';
            if (error) showNotification('#f03434', error);
            else showNotification('#2ecc71', 'Recording requested — check downloads');
        });
    }
</script>
