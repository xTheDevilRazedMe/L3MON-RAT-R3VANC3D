<div class="flex justify-end mb-4">
    <button onclick="updateButton(this, '0xCL')" class="btn-primary text-xs">
        <svg class="w-3 h-3 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        Sync Call Log
    </button>
</div>

<div class="glass rounded-xl overflow-hidden">
    <table class="w-full text-sm">
        <thead>
            <tr class="text-slate-500 text-left border-b border-slate-700/50">
                <th class="px-4 py-3 font-medium">Type</th>
                <th class="px-4 py-3 font-medium">Contact</th>
                <th class="px-4 py-3 font-medium">Date & Time</th>
                <th class="px-4 py-3 font-medium">Duration</th>
            </tr>
        </thead>
        <tbody>
            <% pageData.forEach((callData) => { 
                let date = new Date(parseInt(callData.date));
                let typeLabel = 'Unknown';
                let typeColor = 'text-slate-400';
                let typeBg = 'bg-slate-700/50';
                if(callData.type === 1) { typeLabel = 'Incoming'; typeColor = 'text-accent-green'; typeBg = 'bg-accent-green/10'; }
                if(callData.type === 2) { typeLabel = 'Outgoing'; typeColor = 'text-accent-blue'; typeBg = 'bg-accent-blue/10'; }
                if(callData.type === 3) { typeLabel = 'Missed'; typeColor = 'text-accent-red'; typeBg = 'bg-accent-red/10'; }
            %>
            <tr class="table-row border-b border-slate-700/30">
                <td class="px-4 py-3"><span class="<%= typeBg %> <%= typeColor %> px-2 py-0.5 rounded text-xs font-medium"><%= typeLabel %></span></td>
                <td class="px-4 py-3"><a href="?filter=<%= callData.phoneNo %>" class="text-accent-blue hover:text-accent-cyan transition-colors"><%= callData.phoneNo %></a></td>
                <td class="px-4 py-3 text-slate-400 text-xs"><%= date.toLocaleString('en-GB', { timeZone: 'UTC' }) %></td>
                <td class="px-4 py-3 text-white font-mono text-xs"><%= callData.duration %>s</td>
            </tr>
            <% }); %>
        </tbody>
    </table>
    <% if (pageData.length === 0) { %>
    <div class="text-center py-12 text-slate-500">
        <svg class="w-12 h-12 mx-auto mb-3 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        <p>No call logs found.</p>
    </div>
    <% } %>
</div>
