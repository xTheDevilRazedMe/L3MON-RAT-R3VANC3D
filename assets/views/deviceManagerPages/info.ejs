<% let dyn = pageData.dynamicData || {}; let dev = dyn.device || {}; %>

<div class="grid grid-cols-4 gap-4 mb-6">
    <div class="glass rounded-xl p-4 text-center">
        <div class="w-3 h-3 rounded-full mx-auto mb-2 <%= pageData.isOnline ? 'bg-accent-green glow-green' : 'bg-slate-500' %>"></div>
        <div class="text-xl font-bold text-white"><%= pageData.isOnline ? 'Online' : 'Offline' %></div>
    </div>
    <div class="glass rounded-xl p-4 text-center">
        <div class="text-slate-400 text-xs mb-1">First Seen</div>
        <div class="text-white font-medium text-sm"><%= new Date(pageData.firstSeen).toLocaleString('en-GB', {timeZone:'UTC'}) %></div>
    </div>
    <div class="glass rounded-xl p-4 text-center">
        <div class="text-slate-400 text-xs mb-1">Last Seen</div>
        <div class="text-white font-medium text-sm"><%= new Date(pageData.lastSeen).toLocaleString('en-GB', {timeZone:'UTC'}) %></div>
    </div>
    <div class="glass rounded-xl p-4 text-center">
        <div class="text-slate-400 text-xs mb-1">Device</div>
        <div class="text-white font-medium text-sm"><%= dev.manufacturer %> <%= dev.model %></div>
    </div>
</div>

<div class="grid grid-cols-2 gap-4">
    <!-- System Information -->
    <div>
        <h3 class="text-white font-semibold text-sm mb-3">System Information</h3>
        <div class="glass rounded-xl p-4 space-y-3">
            <div class="flex justify-between text-sm"><span class="text-slate-400">Client ID</span><code class="text-accent-blue"><%= pageData.clientID %></code></div>
            <div class="flex justify-between text-sm"><span class="text-slate-400">IP Address</span><span class="text-white"><%= dyn.clientIP || 'N/A' %></span></div>
            <div class="flex justify-between text-sm"><span class="text-slate-400">Country</span><span class="text-white"><%= dyn.clientGeo && dyn.clientGeo.country ? dyn.clientGeo.country : 'N/A' %></span></div>
            <div class="flex justify-between text-sm"><span class="text-slate-400">Android Version</span><span class="text-white">API <%= dev.version || 'N/A' %></span></div>
            <div class="flex justify-between text-sm"><span class="text-slate-400">Manufacturer</span><span class="text-white"><%= dev.manufacture || 'N/A' %></span></div>
            <div class="flex justify-between text-sm"><span class="text-slate-400">Model</span><span class="text-white"><%= dev.model || 'N/A' %></span></div>
            <div class="flex justify-between text-sm"><span class="text-slate-400">Release</span><span class="text-white"><%= dev.release || 'N/A' %></span></div>
            <div class="flex justify-between text-sm"><span class="text-slate-400">SDK</span><span class="text-white"><%= dev.sdk || 'N/A' %></span></div>
            <div class="flex justify-between text-sm"><span class="text-slate-400">Timezone</span><span class="text-white">UTC</span></div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div>
        <h3 class="text-white font-semibold text-sm mb-3">Quick Actions</h3>
        <div class="glass rounded-xl p-4 grid grid-cols-2 gap-3">
            <a href="/manage/<%= pageData.clientID %>/terminal" class="glass-bright rounded-lg p-4 text-center hover:bg-bg-hover transition-all group">
                <svg class="w-6 h-6 text-accent-green mx-auto mb-2 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <div class="text-white text-sm font-medium">Shell</div>
            </a>
            <a href="/manage/<%= pageData.clientID %>/alpine" class="glass-bright rounded-lg p-4 text-center hover:bg-bg-hover transition-all group">
                <svg class="w-6 h-6 text-accent-cyan mx-auto mb-2 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/></svg>
                <div class="text-white text-sm font-medium">Alpine</div>
            </a>
            <a href="/manage/<%= pageData.clientID %>/location" class="glass-bright rounded-lg p-4 text-center hover:bg-bg-hover transition-all group">
                <svg class="w-6 h-6 text-accent-amber mx-auto mb-2 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
                <div class="text-white text-sm font-medium">GPS</div>
            </a>
            <a href="/manage/<%= pageData.clientID %>/microphone" class="glass-bright rounded-lg p-4 text-center hover:bg-bg-hover transition-all group">
                <svg class="w-6 h-6 text-accent-purple mx-auto mb-2 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
                <div class="text-white text-sm font-medium">Mic</div>
            </a>
        </div>
    </div>
</div>
