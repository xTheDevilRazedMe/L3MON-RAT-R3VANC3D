<div class="flex justify-end mb-4">
    <button onclick="updateButton(this, '0xCO')" class="btn-primary text-xs">
        <svg class="w-3 h-3 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        Sync Contacts
    </button>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
    <% pageData.forEach((contact) => { %>
    <div class="glass-bright rounded-lg p-4 hover:bg-bg-hover transition-all">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-accent-blue/20 flex items-center justify-center text-accent-blue font-bold text-sm flex-shrink-0">
                <%= (contact.name || '?')[0].toUpperCase() %>
            </div>
            <div class="min-w-0">
                <div class="text-white font-medium text-sm truncate"><%= contact.name || 'Unknown' %></div>
                <div class="text-slate-400 text-xs"><%= contact.phoneNo || 'No number' %></div>
            </div>
        </div>
        <div class="flex gap-2 mt-3 pt-3 border-t border-slate-700/50">
            <a href="<%= baseURL %>/calls?filter=<%= contact.phoneNo %>" class="btn-ghost text-xs flex-1 text-center py-1">
                <svg class="w-3 h-3 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Calls
            </a>
            <a href="<%= baseURL %>/sms?filter=<%= contact.phoneNo %>" class="btn-ghost text-xs flex-1 text-center py-1">
                <svg class="w-3 h-3 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
                SMS
            </a>
        </div>
    </div>
    <% }); %>
    <% if (pageData.length === 0) { %>
    <div class="col-span-full text-center py-12 text-slate-500">
        <svg class="w-12 h-12 mx-auto mb-3 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <p>No contacts synced yet.</p>
    </div>
    <% } %>
</div>
